# Leave empty to auto-detect Expo host / emulator.
# For a real phone on Wi‑Fi, set your PC's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.26:5000

EXPO_PUBLIC_API_URL=

# This project uses React Navigation (not expo-router).
# Required on Expo SDK 56+ when opening in Expo Go:
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
