PORT=5000

# Pepper for OTP HMAC (change in any shared/deployed environment)
OTP_SECRET=change-me-to-a-long-random-string

# Admin portal (Vite app in /admin)
ADMIN_EMAIL=admin@blinkit.local
ADMIN_PASSWORD=admin123
ADMIN_TOKEN_SECRET=change-me-admin-token-secret

# Set to 0 to silence OTP console logs even in development
# AUTH_LOG_OTP=0
